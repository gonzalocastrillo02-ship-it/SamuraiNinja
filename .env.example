# URL de la función botRunner de tu app Base44
API_URL=https://us-central1-XXXX.cloudfunctions.net/botRunner

# Clave secreta (debe coincidir con RUNNER_API_KEY configurado en tu app)
RUNNER_API_KEY=tu_clave_larga_aleatoria

# Cada cuántos segundos hacer pull + heartbeat (por defecto 10)
PULL_INTERVAL=10

# Cada cuántos segundos ejecuta cada bot su bucle de features (por defecto 30)
TICK_INTERVAL=30
